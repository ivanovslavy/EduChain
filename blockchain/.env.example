# ---------------------------------------------------------------------------
# EduChain — blockchain/.env.example
#
# Copy this file to `.env` and fill in the keys you actually need.
# `.env` is gitignored.
# ---------------------------------------------------------------------------

# GembaBlockchain RPC (optional — https://rpc1.gembascan.io is used by default)
GEMBA_RPC_URL=

# Legacy — only needed for the Ethereum networks kept in hardhat.config.js for reference
ALCHEMY_API_KEY=
INFURA_API_KEY=
ETHERSCAN_API_KEY=

# Signer keys. USER1 is the deployer in scripts/deploy.js.
# Never commit real private keys.
USER1_PRIVATE_KEY=
USER2_PRIVATE_KEY=
USER3_PRIVATE_KEY=
USER4_PRIVATE_KEY=
USER5_PRIVATE_KEY=

# Legacy — only if you also deploy to BSC / Polygon
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Set to any non-empty value to enable hardhat-gas-reporter during tests
REPORT_GAS=
